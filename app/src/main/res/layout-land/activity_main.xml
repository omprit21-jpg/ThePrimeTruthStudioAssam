<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#090D12"
    android:padding="6dp">

    <!-- LEFT: WIDE CAMERA PREVIEW -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.8"
        android:layout_marginEnd="6dp">

        <androidx.camera.view.PreviewView
            android:id="@+id/cameraPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter" />

        <ImageView
            android:id="@+id/previewLogo"
            android:layout_width="105dp"
            android:layout_height="60dp"
            android:layout_gravity="top|end"
            android:layout_margin="12dp"
            android:src="@drawable/prime_truth_square"
            android:scaleType="fitCenter"
            android:contentDescription="Prime Truth watermark" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_margin="10dp"
            android:padding="8dp"
            android:background="#CC101820"
            android:text="Camera ready"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

    </FrameLayout>

    <!-- RIGHT: NEWSROOM CONTROL PANEL -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:fillViewport="true"
        android:background="#151C24">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="THE PRIME TRUTH STUDIO"
                android:textColor="#E5C12B"
                android:textStyle="bold"
                android:textSize="17sp"
                android:gravity="center"
                android:padding="5dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="LANDSCAPE NEWSROOM"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:gravity="center"
                android:paddingBottom="8dp" />

            <Button
                android:id="@+id/recordButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="● RECORD" />

            <Button
                android:id="@+id/importButton"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="IMPORT VIDEO" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="NEWS HEADLINE"
                android:textColor="#E5C12B"
                android:textStyle="bold"
                android:textSize="12sp"
                android:paddingTop="8dp" />

            <EditText
                android:id="@+id/headlineInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Enter news headline"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#AAAAAA"
                android:backgroundTint="#D5A900"
                android:paddingHorizontal="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="VIDEO TRIMMING (SECONDS)"
                android:textColor="#E5C12B"
                android:textStyle="bold"
                android:textSize="11sp"
                android:paddingTop="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/trimStartInput"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:hint="Start"
                    android:inputType="numberDecimal"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#AAAAAA"
                    android:backgroundTint="#D5A900" />

                <EditText
                    android:id="@+id/trimEndInput"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:hint="End"
                    android:inputType="numberDecimal"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#AAAAAA"
                    android:backgroundTint="#D5A900" />

            </LinearLayout>

            <Button
                android:id="@+id/exportButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:text="EXPORT MP4 WITH AUTO LOGO" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="REAL &amp; RELIABLE"
                android:textColor="#E5C12B"
                android:gravity="center"
                android:textSize="11sp"
                android:padding="8dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
